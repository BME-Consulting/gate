{
  "name": "mc-gate-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @mc-gate/mobile start",
    "mobile:android": "pnpm --filter @mc-gate/mobile android",
    "mobile:ios": "pnpm --filter @mc-gate/mobile ios",
    "mobile:web": "pnpm --filter @mc-gate/mobile web",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "react-native-reanimated": "^4.2.1"
  }
}
