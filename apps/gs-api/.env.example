# Node Environment
NODE_ENV=development
PORT=7070

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mc_gate?schema=public
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak

# Authentication
# Set to 'true' for development (モック認証)
# Set to 'false' for production (Keycloak JWT検証)
MOCK_AUTH=true

# OAuth 2.0 / Keycloak JWT Settings
# AUTH_ISSUER: Keycloak issuer URL (iss クレーム検証用)
AUTH_ISSUER=https://auth-gate-prod.bme-service.monster/realms/mcd3

# AUTH_AUDIENCE: JWT audience (aud クレーム検証用 - Step C-2で使用)
AUTH_AUDIENCE=mc-gate

# AUTH_JWKS_URL: JWKS endpoint (署名検証用 - Step C-2で使用)
AUTH_JWKS_URL=https://auth-gate-prod.bme-service.monster/realms/mcd3/protocol/openid-connect/certs

# Security (Static API Key - 旧方式、後方互換性のため保持)
API_KEY=development-api-key-12345

# CORS (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Legacy (SQLite - 後方互換性のため保持)
DB_PATH=./gs.db
