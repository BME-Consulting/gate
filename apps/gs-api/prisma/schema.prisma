// Prisma Schema for GS API
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Projects Table
// ==========================================
model Project {
  id              String        @id
  name            String
  gateMode        String        @map("gate_mode")
  scanMethodLock  String?       @map("scan_method_lock")
  gateModeLock    String?       @map("gate_mode_lock")
  checkConfig     Json          @map("check_config")
  serverLock      Boolean       @default(false) @map("server_lock")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  scanEvents      ScanEvent[]

  @@index([name])
  @@index([updatedAt])
  @@map("projects")
}

// ==========================================
// Workers Table
// ==========================================
model Worker {
  personId         String        @id @map("person_id")
  name             String
  company          String
  ccusId           String?       @unique @map("ccus_id")
  ccusRegistered   Boolean       @default(false) @map("ccus_registered")
  socialInsurance  Boolean       @default(false) @map("social_insurance")
  residencyExpiry  DateTime?     @map("residency_expiry") @db.Date
  age              Int?
  isSoleProprietor Boolean       @default(false) @map("is_sole_proprietor")
  faceEmbedding    Json?         @map("face_embedding")
  faceImageUrl     String?       @map("face_image_url")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  scanEvents       ScanEvent[]

  @@index([name])
  @@index([company])
  @@index([ccusId])
  @@index([updatedAt])
  @@map("workers")
}

// ==========================================
// Scan Events Table
// ==========================================
model ScanEvent {
  id                        String   @id
  projectId                 String   @map("project_id")
  personId                  String   @map("person_id")
  method                    String
  gateMode                  String   @map("gate_mode")
  decidedMode               String   @map("decided_mode")
  occurredAt                DateTime @map("occurred_at") @db.Timestamptz
  ruleResult                Json     @map("rule_result")
  transportStatus           String   @default("pending") @map("transport_status")
  transportAttempts         Int      @default(0) @map("transport_attempts")
  transportLastError        String?  @map("transport_last_error")
  transportIdempotencyKey   String   @unique @map("transport_idempotency_key")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker    Worker  @relation(fields: [personId], references: [personId], onDelete: Restrict)

  @@index([projectId, occurredAt(sort: Desc)])
  @@index([personId, occurredAt(sort: Desc)])
  @@index([transportStatus])
  @@index([transportIdempotencyKey])
  @@index([projectId, decidedMode, occurredAt], name: "idx_stats")
  @@index([occurredAt], type: Brin)
  @@map("scan_events")
}

// ==========================================
// UX Metrics Table
// ==========================================
model UxMetricEvent {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ✅ 誰が/どの現場か（任意だが、後で死ぬほど効く）
  projectId      String?  @map("project_id")
  tenantId       String?  @map("tenant_id")

  // ✅ イベント本体
  eventType      UxEventType @map("event_type")
  result         UxResult
  failReason     UxFailReason? @map("fail_reason")

  // ✅ UX-2の数値（無いときはnull）
  brightnessScore Float?  @map("brightness_score")
  sharpnessScore  Float?  @map("sharpness_score")

  // ✅ 実行環境
  deviceModel    String?  @map("device_model")
  os             String?  // "android" | "ios" を想定（自由文字列でOK）
  osVersion      String?  @map("os_version")
  appVersion     String?  @map("app_version")
  buildId        String?  @map("build_id")
  runtimeVersion String?  @map("runtime_version")

  // ✅ 通信経路の切り分け（これ重要）
  apiRoute       UxApiRoute @map("api_route")
  faceApiBaseUrl String?  @map("face_api_base_url")
  gsApiBaseUrl   String?  @map("gs_api_base_url")

  // ✅ デバッグ最小（後で原因追跡に使える）
  durationMs     Int?     @map("duration_ms")
  httpStatus     Int?     @map("http_status")
  errorMessage   String?  @map("error_message") @db.Text

  // ✅ 1リクエスト単位の相関ID（mobileでUUID生成推奨）
  sessionId      String?  @map("session_id")
  requestId      String?  @map("request_id")

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([tenantId, createdAt])
  @@index([eventType, result, createdAt])
  @@index([failReason, createdAt])
  @@index([apiRoute, createdAt])
  @@map("ux_metric_events")
}

enum UxEventType {
  FACE_REGISTER
  FACE_VERIFY
}

enum UxResult {
  success
  fail
}

enum UxFailReason {
  quality_dark
  quality_blurred
  no_face
  network
  server
  camera
  not_registered
}

enum UxApiRoute {
  tunnel_url
  lan_url
}
