# Production Environment Configuration
# コピー: cp .env.production.example .env.production
# 注意: .env.production は .gitignore に追加されています

# Node Environment
NODE_ENV=production
PORT=7070

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/mc_gate?schema=public
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Keycloak
KEYCLOAK_URL=https://auth-gate-prod.bme-service.monster
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# Authentication
# 🚨 IMPORTANT: 本番環境では必ず false に設定
MOCK_AUTH=false

# OAuth 2.0 / Keycloak JWT Settings
# AUTH_ISSUER: Keycloak issuer URL (iss クレーム検証用)
AUTH_ISSUER=https://auth-gate-prod.bme-service.monster/realms/mcd3

# AUTH_AUDIENCE: JWT audience (aud クレーム検証用)
# Note: mc-gate-mobile に固定（Audience mapper で aud に追加済み）
AUTH_AUDIENCE=mc-gate-mobile

# AUTH_JWKS_URL: JWKS endpoint (署名検証用)
AUTH_JWKS_URL=https://auth-gate-prod.bme-service.monster/realms/mcd3/protocol/openid-connect/certs

# Security (Static API Key - 旧方式、後方互換性のため保持)
# 🚨 IMPORTANT: 本番環境では強力なランダム文字列に変更
API_KEY=CHANGE_ME_TO_RANDOM_STRING

# CORS (Comma-separated origins)
# 🚨 IMPORTANT: 本番環境では許可するオリジンのみを指定
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Legacy (SQLite - 後方互換性のため保持)
DB_PATH=./gs.db
