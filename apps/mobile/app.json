{
  "expo": {
    "name": "mc-gate",
    "slug": "mc-gate",
    "owner": "bme_llc",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mcgate",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bmeconsulting.mcgate",
      "infoPlist": {
        "NSCameraUsageDescription": "QRコードの読み取りにカメラを使用します。",
        "NSBluetoothAlwaysUsageDescription": "CCUSカードリーダーとの通信にBluetoothを使用します。"
      }
    },
    "android": {
      "package": "com.bmeconsulting.mcgate",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "BLUETOOTH_CONNECT", "BLUETOOTH_SCAN"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "apiBaseGs": "http://192.168.1.4:7070",
      "apiBaseCcus": "http://192.168.1.4:7071",
      "apiFaceApi": "http://192.168.1.4:8100",
      "apiGsApiKey": "development-api-key-12345",
      "apiFaceApiKey": "development-api-key-12345",
      "auth": {
        "issuer": "http://192.168.1.4:8080/auth/realms/mcd3",
        "audience": "mc-gate",
        "clientId": "mc-gate-mobile"
      },
      "useMockAuth": true,
      "eas": {
        "projectId": "0f0feec5-4f4b-4252-ad34-c1594238b4b8"
      }
    },
    "plugins": [
      "expo-updates",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true,
            "infoPlist": {
              "NSAppTransportSecurity": {
                "NSAllowsArbitraryLoads": true
              }
            }
          },
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/0f0feec5-4f4b-4252-ad34-c1594238b4b8"
    }
  }
}
