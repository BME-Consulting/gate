{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@mc-gate/core": ["../../packages/core/src"],
      "@mc-gate/api-client": ["../../packages/api-client/src"],
      "@mc-gate/ui-kit": ["../../packages/ui-kit/src"],
      "@mc-gate/reader-bridge": ["../../packages/reader-bridge/src"],
      "@mc-gate/qr": ["../../packages/qr/src"],
      "@mc-gate/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/*/src/**/*.ts", "../../packages/*/src/**/*.tsx"],
  "exclude": ["node_modules"]
}
