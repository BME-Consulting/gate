# Server configuration
HOST=0.0.0.0
PORT=8100

# API Security
API_KEY=development-api-key-12345

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://192.168.1.4:8081

# Database
DATABASE_PATH=./data/embeddings.db

# Face recognition settings
FACE_DETECTION_MODEL=hog  # hog (CPU) or cnn (GPU)
FACE_RECOGNITION_TOLERANCE=0.6
MAX_IMAGE_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
